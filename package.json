{
  "name": "ai-ts-monorepo-template",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm depcruise && pnpm check:unused && pnpm check:dependencies",
    "check:dependencies": "syncpack lint",
    "check:secrets": "sh scripts/check-secrets.sh",
    "check:unused": "knip",
    "depcruise": "depcruise --config .dependency-cruiser.mjs apps packages",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1",
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "syncpack": "^15.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,mdx,yaml,yml,css,scss,html}": "prettier --write"
  }
}
